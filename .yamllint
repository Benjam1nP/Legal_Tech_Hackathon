---
# Default yamllint rules, relaxed only where the OpenFisca template examples
# use a different (valid) style. Line length is a warning, not an error.
extends: default
ignore-from-file: .gitignore
rules:
  document-start: disable
  truthy:
    check-keys: false
  indentation:
    indent-sequences: whatever
  brackets:
    max-spaces-inside: 1
  line-length:
    max: 120
    level: warning
